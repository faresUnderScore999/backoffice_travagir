<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="500" prefWidth="700"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@../../css/voyageView.css, @../../css/addUser.css"
      fx:controller="java_project.controllers.association.LinkedUsersController"
      spacing="15" styleClass="card">

    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-label-container">
            <Label fx:id="titleLabel" text="Linked Users" styleClass="header-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="✕ Close" onAction="#handleClose" styleClass="secondary-button" />
        </HBox>
    </VBox>

    <VBox VBox.vgrow="ALWAYS">
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colName" text="Name" prefWidth="200" style="-fx-alignment: CENTER_LEFT;" />
                <TableColumn fx:id="colEmail" text="Email" prefWidth="250" style="-fx-alignment: CENTER_LEFT;" />
                <TableColumn fx:id="colTel" text="Phone" prefWidth="120" style="-fx-alignment: CENTER;" />
                <TableColumn fx:id="colActions" text="Actions" prefWidth="100" style="-fx-alignment: CENTER;" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="footer-bar">
        <Label fx:id="statusLabel" text="Status: Ready" styleClass="status-label info" />
    </HBox>
</VBox>
