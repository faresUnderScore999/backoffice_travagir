<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="768" prefWidth="1376.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@../css/voyageView.css" 
      fx:controller="java_project.controllers.RefundRequestController"
      spacing="25"
    styleClass="root card">

    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-label-container">
            <Label text="💰 Refund Management" styleClass="header-label" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

 <VBox spacing="15">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="refund-form-row">
        <TextField fx:id="amountField" promptText="Amount" HBox.hgrow="NEVER" prefWidth="160" styleClass="refund-input" />
        <TextArea fx:id="reasonArea" promptText="Reason" prefRowCount="1" HBox.hgrow="ALWAYS" styleClass="refund-input refund-reason" />
        <Button text="+ Add Refund" onAction="#handleAdd" styleClass="add-user" />
    </HBox>

    <!-- Tools row: Search + Sort (compact, aligned) -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="refund-tools-row">
        <ChoiceBox fx:id="searchTypeChoice" prefWidth="140" styleClass="refund-choice" />
        <StackPane HBox.hgrow="ALWAYS">
            <ChoiceBox fx:id="searchValueChoice" styleClass="refund-choice refund-tools-input" />
            <TextField fx:id="searchField" promptText='Search (ex: status:pending amount:>50 "flight delayed" -rejected | id:12)' styleClass="refund-input refund-search-field refund-tools-input" />
        </StackPane>
        <ChoiceBox fx:id="sortFieldChoice" prefWidth="150" styleClass="refund-choice" />
        <ChoiceBox fx:id="sortOrderChoice" prefWidth="140" styleClass="refund-choice" />
    </HBox>

    <TableView fx:id="refundTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="80" />
            <TableColumn fx:id="amountCol" text="Amount" prefWidth="120" />
            <TableColumn fx:id="statusCol" text="Status" prefWidth="160" />
            <TableColumn fx:id="reasonCol" text="Description" prefWidth="420" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="approveButton" text="Approve" onAction="#handleApproveSelected" styleClass="primary-button" />
        <Button fx:id="rejectButton" text="Reject" onAction="#handleRejectSelected" styleClass="secondary-button" />
        <Button fx:id="deleteButton" text="Delete" onAction="#handleDeleteSelected" styleClass="secondary-button" />
    </HBox>
</VBox>

    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="footer-bar">
        <Label text="✅ Status: " styleClass="status-label" />
    </HBox>

</VBox>
