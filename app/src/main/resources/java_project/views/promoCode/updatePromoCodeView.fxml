<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="TOP_CENTER" prefWidth="550" prefHeight="700"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="java_project.controllers.promoCode.UpdatePromoCodeController"
      stylesheets="@../../css/addUser.css" styleClass="form-card">
    
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <VBox spacing="5" alignment="CENTER_LEFT" styleClass="form-header">
        <Label text="Update Promo Code" styleClass="form-title"/>
        <Label text="Modify the promo code details for the selected offer." styleClass="form-subtitle"/>
    </VBox>

    <Separator/>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
        <GridPane vgap="15" hgap="10">
            <columnConstraints>
                <ColumnConstraints prefWidth="130" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Promo Code" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="codeField" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field" promptText="Enter promo code"/>

            <Label text="Description" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextArea fx:id="descriptionArea" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field" 
                     promptText="Enter description" prefHeight="80"/>

            <Label text="Select Offer" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
            <ComboBox fx:id="offerComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" 
                     prefWidth="250" promptText="Choose an offer"/>

            <Label text="Valid From" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
            <DatePicker fx:id="validFromPicker" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="form-field"/>

            <Label text="Valid To" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="field-label"/>
            <DatePicker fx:id="validToPicker" GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="form-field"/>

            <Label text="Usage Limit" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="field-label"/>
            <TextField fx:id="usageLimitField" GridPane.rowIndex="5" GridPane.columnIndex="1" styleClass="form-field" 
                     promptText="Maximum uses"/>

            <Label text="Active Status" GridPane.rowIndex="6" GridPane.columnIndex="0" styleClass="field-label"/>
            <CheckBox fx:id="activeCheckBox" GridPane.rowIndex="6" GridPane.columnIndex="1" styleClass="form-checkbox"/>
        </GridPane>
    </ScrollPane>

    <Separator/>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
        <Button text="Update Promo Code" onAction="#handleSave" styleClass="submit-button"/>
    </HBox>
</VBox>
