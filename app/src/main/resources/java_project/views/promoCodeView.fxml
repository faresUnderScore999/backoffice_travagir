<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="768" prefWidth="1376.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" 
      stylesheets="@../css/voyageView.css" 
      fx:controller="java_project.controllers.PromoCodeController" 
      spacing="25" 
      styleClass="card">
    
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-label-container">
            <Label text="🎫 Promo Code Management" styleClass="header-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="15" alignment="CENTER_RIGHT">
                <padding>
                    <Insets right="20"/>
                </padding>
                <Button text="🔄 Refresh" onAction="#handleRefresh" styleClass="secondary-button"/>
                <Button text="📧 Email Promo" onAction="#handleSendPromoCodeEmail" styleClass="email-button"/>
                <Button text="+ Add Promo Code" onAction="#handleAddPromoCode" styleClass="add-user"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Search and Filter Section -->
    <VBox spacing="10" styleClass="filter-section">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="🔍 Search:" styleClass="filter-label"/>
            <TextField fx:id="searchField" prefWidth="250" styleClass="search-field" promptText="Search by code or description..."/>
            
            <Label text="📦 Offer:" styleClass="filter-label"/>
            <ComboBox fx:id="offerComboBox" prefWidth="200" promptText="All Offers" styleClass="combo-box"/>
            
            <Button text="📊 Statistics" onAction="#showStatisticsView" styleClass="stats-button"/>
            
            <Button text="📄 Export CSV" onAction="#exportToCSV" styleClass="export-button"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <VBox spacing="5" styleClass="status-filters">
                <Label text="Status:" styleClass="filter-label"/>
                <HBox spacing="10">
                    <CheckBox fx:id="activeFilterCheckBox" text="Active" styleClass="status-checkbox" selected="true"/>
                    <CheckBox fx:id="inactiveFilterCheckBox" text="Inactive" styleClass="status-checkbox" selected="true"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox VBox.vgrow="ALWAYS">
        <StackPane VBox.vgrow="ALWAYS">
            <!-- TableView (default view) -->
            <TableView fx:id="promoCodeTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn text="Code" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Description" prefWidth="200"/>
                    <TableColumn text="Offer ID" prefWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Valid From" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Valid To" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Usage" prefWidth="100" style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Active" prefWidth="80" style="-fx-alignment: CENTER;"/>
                    <TableColumn text="Actions" prefWidth="150" style="-fx-alignment: CENTER;"/>
                </columns>
            </TableView>
            
            <!-- Statistics View (initially hidden) -->
            <VBox fx:id="statisticsView" spacing="20" style="-fx-padding: 20; -fx-background-color: #f5f5f5;" visible="false">
                <!-- Will be populated in controller -->
            </VBox>
        </StackPane>
    </VBox>
</VBox>
