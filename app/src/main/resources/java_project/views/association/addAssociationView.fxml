<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_CENTER" prefWidth="520" prefHeight="420"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="java_project.controllers.association.AddAssociationController"
      stylesheets="@../../css/addUser.css, @../../css/voyageView.css" styleClass="form-card">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <VBox spacing="5" alignment="CENTER_LEFT" styleClass="form-header">
        <Label text="Create Association" styleClass="form-title"/>
        <Label text="Provide association details." styleClass="form-subtitle"/>
    </VBox>

    <Separator />

    <GridPane vgap="12" hgap="12">
        <columnConstraints>
            <ColumnConstraints prefWidth="130" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="nameField" promptText="e.g. Global Tech Corp" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="form-field"/>

        <Label text="Company Code" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="companyCodeField" promptText="GTC_2024" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="form-field"/>

        <Label text="Discount (%)" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
        <TextField fx:id="discountRateField" promptText="15.5" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="form-field"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" />

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel" styleClass="cancel-button"/>
        <Button text="Save" onAction="#handleSave" styleClass="submit-button"/>
    </HBox>
</VBox>