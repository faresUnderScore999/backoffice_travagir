<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="768" prefWidth="1000" spacing="25" styleClass="card" 
      stylesheets="@../css/voyageView.css" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="java_project.controllers.ActivityController">
    
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-label-container">
        <Label text="🏄 Activity Management" styleClass="header-label" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Add Activity" onAction="#openAddActivityModal" styleClass="add-user" />
        <Button text="🔄 Refresh" onAction="#loadActivities" styleClass="secondary-button" />
    </HBox>

    <TableView fx:id="activityTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colName" text="Activity Name" prefWidth="200" />
            <TableColumn fx:id="colDescription" text="Description" prefWidth="280" />
            <TableColumn fx:id="colLocation" text="Location" prefWidth="150" />
            <TableColumn fx:id="colPrice" text="Price ($)" prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="220" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="footer-bar">
        <Label fx:id="statusLabel" text="✅ Status: Ready" styleClass="status-label info" />
    </HBox>
</VBox>